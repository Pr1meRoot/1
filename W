--- НАВИГАЦИЯ И ПАПКИ ---
cd \                   — Перейти в корень диска (например, C:\)
cd папка               — Перейти в конкретную папку
cd ..                  — Подняться на один уровень вверх (назад)
D:                     — Переключиться на другой диск (например, на диск D)
dir                    — Показать список всех файлов и папок в текущей директории
mkdir имя_папки        — Создать новую папку

--- РАБОТА С ФАЙЛАМИ ---
type файл.txt          — Вывести содержимое текстового файла на экран
echo текст > файл.txt  — Создать файл и записать в него текст (перезапишет файл)
echo текст >> файл.txt — Дописать текст в конец существующего файла
copy файл.txt папка\   — Скопировать файл в другую папку
move файл.txt папка\   — Переместить файл в другую папку
del файл.txt           — Удалить файл
rmdir имя_папки /s /q  — Удалить папку со всем её содержимым без подтверждения

--- СЕТЬ И ДИАГНОСТИКА ---
ipconfig               — Показать сетевые настройки (IP-адрес, маску сети)
ipconfig /flushdns     — Очистить кэш DNS (полезно, если не открываются сайты)
ping google.com        — Проверить доступность сайта или сервера
tracert google.com     — Трассировка маршрута (показывает путь пакета через узлы)
netstat -ano           — Показать все активные сетевые соединения и порты

--- СИСТЕМА И ПРОЦЕССЫ ---
tasklist               — Показать список всех запущенных процессов
taskkill /F /IM app.exe— Принудительно закрыть программу по её имени (например, chrome.exe)
taskkill /F /PID 1234  — Принудительно закрыть программу по её ID процесса
systeminfo             — Вывести подробную информацию о системе и железе
cls                    — Очистить экран терминала
exit                   — Закрыть командную строку
